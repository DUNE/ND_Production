{
  "ufw": {
    "ufw-loglevel": "debug",
    "ufw-basepath": "",
    "ufw-ldpath": [
      "/usr/local/lib64"
    ],
    "ufw-env": {}
  },
  "globals": {
    "sand::root_tgeomanager": {
      "geometry": ""
    }
  },
  "contexts": {
    "keys": 1,
    "locals": {
      "sand::edep_reader": {
        "uri": ""
      },
      "sand::genie_reader": {
        "uri": ""
      }
    }
  },
  "run": [
    {
      "sand::common::truth_filler": {},
      "reqs": {},
      "prods": {
        "out_truth_branch": "produced_truth"
      }
    },
    {
      "sand::common::fast_reco": {},
      "reqs": {
        "in_truth": "produced_truth"
      },
      "prods":{
        "out_common": "produced_common",
        "out_nd": "produced_nd"
      }
    },
    {
      "sand::test::fast_reco_test": {},
      "reqs": {
        "in_truth": "produced_truth",
        "in_common": "produced_common",
        "in_nd": "produced_nd"
      },
      "prods": {}
    },
    {
      "sand::common::gauss_smearing": {
        "energy_resolution": 1,
        "momentum_resolution": 1,
        "x_resolution": 1,
        "y_resolution": 1,
        "z_resolution": 1
      },
      "reqs": {
        "in_common": "produced_common"
      },
      "prods": {
        "out_common": "produced_common_smeared"
      }
    },
    {
      "sand::common::gluckstern_smearing": {
        "intrinsic_pos_res_t" : 1,
        "intrinsic_pos_res_l" : 1,
        "hit_energy_thr" : 1,
        "b_field_magnitude" : 1
      },
      "reqs": {
        "in_nd": "produced_nd",
        "in_truth": "produced_truth"
      },
      "prods": {
        "out_nd": "produced_nd_smeared"
      }
    },
    {
      "sand::caf::caf_streamer": {
        "uri": "",
        "tree": "cafTree"
      },
      "write": ["produced_truth", "produced_common_smeared", "produced_nd_smeared"]
    }
  ]
}